# ARG GARAGE AUTOPARTS — variables de entorno
# Copiar este archivo a .env.local y completar. .env.local está en .gitignore
# (patrón ".env*") — NUNCA hardcodear ninguna de estas claves en el código.

# ── Supabase ────────────────────────────────────────────────────────────
# Settings → API en supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Resend (emails transaccionales) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_OWNER_EMAIL=

# ── Stripe — procesador principal, cobra en USD ────────────────────────
# dashboard.stripe.com → Developers → API keys / Webhooks.
# Empezar SIEMPRE con las claves de test (sk_test_ / pk_test_ / whsec_ de un
# webhook en modo test). Recién en el paso 9 del brief se pasa a productivas.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mercado Pago — opcional, bloqueado por CUIT/CUIL + cuenta bancaria
#    argentina (ver claude/pagos-2026-09-05.md). No completar hasta que
#    eso se resuelva del lado de Omar.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
# URL pública del sitio — la usan los success_url/cancel_url de Stripe.
# En local: http://localhost:3000
APP_URL=
