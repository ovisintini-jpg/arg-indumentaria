# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Carpeta que crea el puente con el asistente (Claude) al trabajar en este
# repo. No es del proyecto y no va a git.
/sessions/
/Claude outputs/

# Empaquetados del propio proyecto (snapshots para revisar). No van a git.
*.tgz
*.zip

# Respaldos de fotos que quedaron al elegir los recortes del hero.
# Borralos cuando ya no los necesites.
/public/images/*-anterior.*
/public/images/*-alternativa-*.*
